# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit LF for shell scripts and Python code
*.sh text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.cfg text eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.iso binary
*.qcow2 binary
*.vdi binary
